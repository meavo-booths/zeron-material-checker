{
  "name": "zeron-material-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Zeron delivery price outlier checker for Meavo (zeron.meavo.app)",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "echo 'db:push is disabled. The shared schema lives in the meavo-db repo (github.com/meavo-booths/meavo-db) — make changes there.' && exit 1",
    "db:studio": "prisma studio",
    "db:seed": "echo 'Users and tool-card access are managed in meavo-gateway. Run scripts/seed-zeron-tool-card.ts there.' && exit 1",
    "test": "tsx --test src/lib/**/*.test.ts"
  },
  "prisma": {
    "schema": "node_modules/@meavo/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@meavo/db": "git+https://github.com/meavo-booths/meavo-db.git#v0.111.0",
    "@prisma/client": "^6.1.0",
    "googleapis": "^144.0.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "prisma": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
