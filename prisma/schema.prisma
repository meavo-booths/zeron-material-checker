generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Identity & access (shared Meavo tables; owned by gateway) ----
// Local subset for auth + ToolCardAccess checks. Never db:push this schema.

enum SystemRole {
  ADMIN
  USER
}

enum ToolCardKind {
  LINK
  APP_ACCESS
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  systemRole    SystemRole @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts   Account[]
  cardAccess ToolCardAccess[]
  importRuns ZeronImportRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model ToolCard {
  id           String           @id @default(cuid())
  name         String
  description  String
  url          String
  iconKey      String?
  kind         ToolCardKind     @default(LINK)
  linkedAppKey String?
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  access       ToolCardAccess[]

  @@unique([linkedAppKey])
}

model ToolCardAccess {
  id        String   @id @default(cuid())
  userId    String
  cardId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card ToolCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
}

// ---- Zeron Material Checker (owner: zeron) ----

enum ZeronImportSourceType {
  GOOGLE_SHEET_TAB
  CSV_UPLOAD
}

enum ZeronImportStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

model ZeronSheetState {
  id            String    @id @default("default")
  spreadsheetId String    @default("")
  lastSyncedAt  DateTime?
  lastError     String?
  updatedAt     DateTime  @updatedAt
}

model ZeronImportRun {
  id            String                @id @default(cuid())
  sourceType    ZeronImportSourceType
  sourceName    String
  status        ZeronImportStatus     @default(PENDING)
  triggeredById String?
  rowCount      Int                   @default(0)
  skippedCount  Int                   @default(0)
  errorCount    Int                   @default(0)
  errors        String                @default("[]")
  createdAt     DateTime              @default(now())
  completedAt   DateTime?

  triggeredBy  User?              @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  deliveryRows ZeronDeliveryRow[]
  importedTabs ZeronImportedTab[]

  @@index([createdAt])
  @@index([sourceType])
}

model ZeronImportedTab {
  id            String   @id @default(cuid())
  spreadsheetId String
  tabName       String
  contentHash   String
  rowCount      Int      @default(0)
  importedAt    DateTime @default(now())
  importRunId   String?

  importRun ZeronImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  @@unique([spreadsheetId, tabName])
  @@index([spreadsheetId])
}

model ZeronDeliveryRow {
  id                String                @id @default(cuid())
  importRunId       String
  sourceKey         String                @unique
  processNumber     String
  deliveryDate      DateTime
  itemCode          String
  itemName          String                @default("")
  stockQuantity     String?
  unit              String?
  unitCost          String
  totalCost         String?
  warehouse         String?
  extraCost         String?
  itemType          String?
  sourceFileName    String?
  attachmentPresent Boolean               @default(false)
  sourceTab         String?
  sourceType        ZeronImportSourceType

  importRun ZeronImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  @@index([itemCode])
  @@index([deliveryDate])
  @@index([processNumber])
  @@index([attachmentPresent])
  @@index([importRunId])
}
